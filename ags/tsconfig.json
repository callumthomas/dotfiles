    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "env.d.ts"]
}
