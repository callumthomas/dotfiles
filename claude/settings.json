{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(jq:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(env:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(stat:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(clippy:*)",
      "Bash(rustfmt:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(git:*)",
      "Bash(npx tsc *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh repo clone *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh status *)",
      "Bash(gh browse *)",
      "Bash(gh gist list *)",
      "Bash(gh gist view *)",
      "Bash(gh label list *)",
      "Bash(gh project list *)",
      "Bash(gh project view *)",
      "Bash(gh api *)",
      "Bash(docker logs *)",
      "Bash(docker restart *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker exec *)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(pacman:*)",
      "Bash(paru:*)",
      "Bash(yay:*)",
      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(rm:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/cal/dev/agentic-memory/hooks/memory-recall.sh",
            "timeout": 5,
            "statusMessage": "Searching team memory..."
          },
          {
            "type": "command",
            "command": "echo '{ \"systemMessage\": \"What  a great prompt!\" }'",
            "timeout": 5,
            "statusMessage": ""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"VERIFICATION REQUIRED: Before pushing, confirm you have actually run tests or checked CI status in this session. Do not push based on assumptions that tests will pass.\"}}'",
            "if": "Bash(git push*)",
            "statusMessage": "Push verification check"
          },
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"VERIFICATION REQUIRED: Before creating a PR, confirm you have actually run tests or checked CI status. Do not create a PR based on assumptions that tests pass.\"}}'",
            "if": "Bash(gh pr create*)",
            "statusMessage": "PR verification check"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pr-review@delio-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "skill-profiler@claude-tools": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@superpowers-dev": true,
    "pdf-simplifier@claude-tools": true
  },
  "extraKnownMarketplaces": {
    "claude-tools": {
      "source": {
        "source": "github",
        "repo": "callumthomas/claude-tools"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "git",
        "url": "https://github.com/obra/superpowers.git"
      }
    },
    "delio-plugins": {
      "source": {
        "source": "github",
        "repo": "deliowales/claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
