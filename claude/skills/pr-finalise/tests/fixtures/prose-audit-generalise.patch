--- a/cmd/report/main.go
+++ b/cmd/report/main.go
@@ -12,0 +13,9 @@ import (
+// FetchHoldings returns the holdings for an account.
+func FetchHoldings(id string) ([]Holding, error) {
+	// Retry once because the upstream API is flaky at cold start.
+	rows, err := query(id)
+	if err != nil {
+		return nil, err
+	}
+	return rows, nil
+}
