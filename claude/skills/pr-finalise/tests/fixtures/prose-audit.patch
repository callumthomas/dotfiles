+#!/usr/bin/env python3
+"""Build the monthly holdings report from ledger snapshots."""
+import json  # noqa: F401
+from datetime import date
+
+# Load the snapshot and group by account
+def load_snapshot(path):
+    with open(path) as fh:
+        return json.load(fh)  # type: ignore[no-any-return]
+
+
+def group_by_account(rows):
+    """Return rows keyed by account id."""
+    grouped = {}
+    for row in rows:
+        # TODO handle closed accounts
+        grouped.setdefault(row["account_id"], []).append(row)
+    return grouped
+
+
