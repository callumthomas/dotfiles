{
	"layer": "top",
	"position": "top",
	"height": 32,
	"spacing": 0,
	"modules-left": [
		"hyprland/workspaces",
		"tray"
	],
	"modules-center": ["hyprland/window"],
	"modules-right": [
		"network",
		"battery",
		"bluetooth",
		"pulseaudio",
		"backlight",
		"custom/temperature",
		"custom/memory-usage",
		"custom/cpu-usage",
		"clock"
	],
	"include": [
		"~/.config/waybar/modules.json"
	],
}


