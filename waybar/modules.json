{
	"hyprland/workspaces": {
		"disable-scroll": false,
		"all-outputs": true,
		"format": "{icon}",
		"on-click": "activate",
	},
	"hyprland/window": {
		"format": {},
		"max-length": 50,
		"rewrite": {
			"(.*) - Mozilla Firefox": "🌎 $1",
			"(.*) — Mozilla Firefox": "🌎 $1",
			"(.*) - Delio - Slack": "💬 $1",
			"^\\s*$": "  ...  "
		}
	},
	"network": {
		"format-wifi": "<span color='#00FFFF'>󰤨 </span>",
		"format-ethernet": "<span color='#7FFF00'> </span>",
		"tooltip-format": "<span color='#FF1493'>󰅧 </span>{bandwidthUpBytes}  <span color='#00BFFF'> 󰅢 </span>{bandwidthDownBytes}",
		"format-linked": "<span color='#FFA500'>󱘖 </span>",
		"format-disconnected": "<span color='#FF4040'> </span>",
		"interval": 1
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "<span color='#28CD41'>{icon} </span>",
		"format-alt": "<span color='#28CD41'>{icon} </span>{capacity}% ",
		"format-charging": " 󱐋{capacity}%",
		"interval": 1,
		"format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
		"tooltip": true
	},
	"pulseaudio": {
		"format": "<span color='#00FF7F'>{icon}</span>",
		"format-muted": "<span color='#FF4040'>󰖁 </span>",
		"format-icons": {
			"default": [
				"<span color='#808080'></span>",
				"<span color='#FFFF66'></span>",
				"<span color='#00FF7F'> </span>"
			]
		},
		"on-click-right": "pavucontrol -t 3",
		"on-click": "pactl -- set-sink-mute 0 toggle",
		"tooltip": true,
		"tooltip-format": "{volume}%"
	},
	"custom/temperature": {
		"exec": "~/.config/waybar/scripts/temperature_details.sh",
		"return-type": "json",
		"format": "",
		"interval": 5,
		"tooltip": true
	},
	"custom/memory-usage": {
        "exec": "~/.config/waybar/scripts/memory_details.sh",
        "return-type": "json",
        "format": "   ",
        "interval": 5,
        "tooltip": true
    },
	"custom/cpu-usage": {
		"exec": "~/.config/waybar/scripts/cpu_details.sh",
		"return-type": "json",
		"format": "  ",
		"interval": 5,
		"tooltip": true
	},
	"clock": {
		"interval": 1,
		"timezone": "Europe/London",
		"format": " {:%H:%M} ",
		"tooltip": true,
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b>{}</b></span>"

			}
		}
	},
	"tray": {
		"icon-size": 17,
		"spacing": 6
	},
	"bluetooth": {
		"format": "<span color='#A9A9A9'>  </span>",
		"format-connected": "<span color='#00BFFF'>  </span>} ",
		"format-connected-battery": "<span color='#00BFFF'>  </span>",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
	}
}
